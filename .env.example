# =============================================================================
# MẪU BIẾN MÔI TRƯỜNG SNAPOG STUDIO
# =============================================================================
# Hướng dẫn:
# 1. Tạo file mới tên là `.env` hoặc `.env.local` ở thư mục gốc này.
# 2. Dán API Key thật của bạn vào bên dưới.
# 3. File `.env` và `.env.local` đã được thêm vào `.gitignore` nên an toàn 100%,
#    KHÔNG BAO GIỜ bị lộ hay đẩy lên GitHub!
# =============================================================================

# Khóa Google Gemini API của bạn (Lấy tại: https://aistudio.google.com/app/apikey)
VITE_GEMINI_API_KEY=your_actual_gemini_api_key_here

# Mô hình bạn muốn dùng: gemini-3.5-flash hoặc gemini-3.5-flash-lite
VITE_GEMINI_MODEL=gemini-3.5-flash
